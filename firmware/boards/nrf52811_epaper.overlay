&spi1 {
    compatible = "nordic,nrf-spi";
    status = "okay";
    sck-pin = <17>;
    mosi-pin = <18>;
    cs-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;

    epaper: epaper@0 {
        compatible = "codex,epaper-ssd1680";
        reg = <0>;
        spi-max-frequency = <4000000>;
        dc-gpios = <&gpio0 21 GPIO_ACTIVE_LOW>;
        reset-gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;
        busy-gpios = <&gpio0 23 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;
        cs-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;
        width = <250>;
        height = <122>;
    };
};